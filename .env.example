# Salin menjadi .env di root proyek CI4
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# --- SQL Server ---
# Named instance: NAMA-PC\SQLEXPRESS (tanpa port). Default instance: nama-server atau IP.
database.default.hostname = localhost
database.default.database = CBI_Checksheet
database.default.username = sa
database.default.password = GantiPasswordAnda
database.default.DBDriver = SQLSRV
database.default.DBPrefix =
database.default.port = 1433
database.default.encrypt = false
